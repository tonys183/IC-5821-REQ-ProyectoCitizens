generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  NEIGHBOR
  MUNICIPALITY
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(NEIGHBOR)
  created_at DateTime @default(now())
  
  neighborProfile     NeighborProfile?
  municipalityProfile MunicipalityProfile?
  
  alerts    Alert[]

  reports   report[]

  @@map("users")
}

model NeighborProfile {
  id              Int     @id @default(autoincrement())
  first_name      String  @db.VarChar(100)
  last_name       String  @db.VarChar(100)
  second_last_name String? @db.VarChar(100)
  identification  Int     @unique // Cédula
  phone_number    Int?

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @unique // one-to-one relation

  @@map("neighbor_profiles")
}

model MunicipalityProfile {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(255) // e.g., "Municipalidad de Alajuela"
  canton      String @db.VarChar(100)

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @unique 

  @@map("municipality_profiles")
}

model Alert {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  content     String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId Int

  @@map("alerts")
}

model canton {
  canton_id   Int        @id @default(autoincrement())
  canton_name String?    @db.VarChar(100)
  district    district[]
  report      report[]
}

model district {
  district_id                      Int      @id @default(autoincrement())
  district_name                    String?  @db.VarChar(100)
  canton_id                        Int?
  canton                           canton?  @relation(fields: [canton_id], references: [canton_id], onDelete: NoAction, onUpdate: NoAction)
  report_report_districtTodistrict report[] @relation("report_districtTodistrict")
}

model problem {
  problem_id      Int           @id @default(autoincrement())
  problem_type_id Int?
  problem_name    String?
  problem_type    problem_type? @relation(fields: [problem_type_id], references: [problem_type_id], onDelete: NoAction, onUpdate: NoAction)
  report          report[]
}

model problem_type {
  problem_type_id Int       @id @default(autoincrement())
  type_name       String?
  problem         problem[]
}

model report {
  report_id                          Int       @id @default(autoincrement())
  author_id                          Int?      // Changed from neighbor_id
  report_title                       String?   @db.VarChar(100)
  problem_id                         Int?
  canton_id                          Int?
  district                           Int?
  neighborhood                       String?   @db.VarChar(100)
  street                             String?   @db.VarChar(100)
  report_date                        DateTime? @db.Date
  report_time                        DateTime? @db.Time(6)
  status                             String?   @default("Waiting") @db.VarChar(100)
  updated_at                         DateTime? @updatedAt
  canton                             canton?   @relation(fields: [canton_id], references: [canton_id], onDelete: NoAction, onUpdate: NoAction)
  district_report_districtTodistrict district? @relation("report_districtTodistrict", fields: [district], references: [district_id], onDelete: NoAction, onUpdate: NoAction)
  author                             User?     @relation(fields: [author_id], references: [id], onDelete: SetNull, onUpdate: Cascade) // Changed from neighbor to User and neighbor_id to author_id
  problem                            problem?  @relation(fields: [problem_id], references: [problem_id], onDelete: NoAction, onUpdate: NoAction)
}
